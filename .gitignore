identifiers.json
exceptions.json
/config.json
identifiers.toml
exceptions.toml
/config.toml
!src/siftfetch/templates/*.json
egress-decisions.jsonl
/.dev/research/siftfetch/observations.jsonl
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/

# Local test and run output
.test-runs/
.test-temp/
/.test-tmp-*/
/.pytest-sol-audit-run-*/
/.test-astra-pr-*/
/.pytest-search-diag/
/pytest-cache-files-*/
.test-cache-b2*/
runs/
*.log
