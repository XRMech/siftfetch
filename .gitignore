# Your protected details and site lists. The real files live in
# ~/.siftfetch/; these entries catch copies made by accident.
identifiers.json
exceptions.json
/config.json
identifiers.toml
exceptions.toml
/config.toml
!src/siftfetch/templates/*.json
egress-decisions.jsonl
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/

# Local test and run output
.test-runs/
.test-temp/
.test-tmp-b2-*/
.test-cache-b2*/
runs/
*.log
